# Kick Gateway live transcriber - environment for the launchd agent (KEY=VALUE, one per line).
# Copy to ~/.config/kickgateway/transcriber.env and fill in the broker credentials.
# Everything here maps 1:1 to the service's configuration (double underscore = section separator).

# RabbitMQ the gateway publishes to (the Mac must be able to reach it - LAN/VPN).
RabbitMq__Host=broker.example.internal
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__Username=
RabbitMq__Password=

# Whisper. Apple Silicon runs Whisper on the GPU through Metal automatically (UseGpu=true).
Transcriber__Model=LargeV3Turbo
Transcriber__Quantization=Q5_0
# Language: every chunk goes through Whisper's language detector restricted to the candidates below;
# the channel switches when the same other language is read confidently (p >= MinProbability) in
# ConfirmChunks consecutive chunks - one-off chunks of music or a clip never flip it. Language = where
# a channel starts and what it falls back to. Leave Languages empty to pin a single language instead.
Transcriber__Language=pl
Transcriber__Languages=pl,en,de
Transcriber__LanguageSwitchMinProbability=0.7
Transcriber__LanguageSwitchConfirmChunks=2
Transcriber__UseGpu=true

# Restrict to specific channels (default: every channel on the video exchange).
# Transcriber__Channels__0=some-slug
# Transcriber__Channels__1=another-slug

# Names / slang the model should spell right.
# Transcriber__Prompt=Łazan, Petrusek, ciotka

# The api stores every transcript in the database; local .txt/.jsonl files are optional.
Transcriber__WriteFiles=false

Logging__LogLevel__Default=Information
