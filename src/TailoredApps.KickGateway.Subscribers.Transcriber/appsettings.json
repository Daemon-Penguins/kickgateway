{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "MassTransit": "Warning"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Transcriber": {
    "Channels": [],
    "QueueName": "transcriber",
    "Language": "pl",
    "Languages": "pl,en,de",
    "LanguageSwitchMinProbability": 0.7,
    "LanguageSwitchConfirmChunks": 2,
    "Model": "LargeV3Turbo",
    "Quantization": "Q5_0",
    "ModelDir": "",
    "UseGpu": true,
    "GpuDevice": 0,
    "DisableVulkanCoopmat": true,
    "Threads": 0,
    "BeamSize": 0,
    "Prompt": "",
    "Uncensored": true,
    "SuppressCensorTokens": false,
    "FfmpegPath": "ffmpeg",
    "ChunkSeconds": 15,
    "MinChunkSeconds": 2,
    "SilenceRms": 0.006,
    "MaxNoSpeechProbability": 0.6,
    "MinConfidence": 0.35,
    "IdleFlushSeconds": 8,
    "SessionTimeoutSeconds": 120,
    "MaxPendingChunks": 8,
    "InferenceTimeoutSeconds": 60,
    "PublishToBus": true,
    "WriteFiles": true,
    "OutputDir": ""
  }
}
