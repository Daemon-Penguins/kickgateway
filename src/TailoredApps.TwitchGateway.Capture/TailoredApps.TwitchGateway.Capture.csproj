<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TailoredApps.TwitchGateway.Capture</RootNamespace>
    <UserSecretsId>tailoredapps-twitchgateway-capture</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.*" />
    <PackageReference Include="MassTransit" Version="8.*" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TailoredApps.Integrations.Twitch\TailoredApps.Integrations.Twitch.csproj" />
    <ProjectReference Include="..\TailoredApps.TwitchGateway.Contracts\TailoredApps.TwitchGateway.Contracts.csproj" />
    <ProjectReference Include="..\TailoredApps.KickGateway.Data\TailoredApps.KickGateway.Data.csproj" />
    <ProjectReference Include="..\TailoredApps.KickGateway.ServiceDefaults\TailoredApps.KickGateway.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
