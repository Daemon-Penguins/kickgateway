<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>TailoredApps.Integrations.Twitch</PackageId>
    <Description>Twitch client pieces the gateway needs: OAuth (authorization code + refresh + validate + app token), Helix (users, streams, EventSub subscriptions), the EventSub WebSocket protocol, and live playback (GQL access token + usher HLS with ad-break detection).</Description>
    <Version>0.1.0</Version>
    <RootNamespace>TailoredApps.Integrations.Twitch</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>
</Project>
